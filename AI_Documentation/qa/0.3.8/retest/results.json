      "verdict": "CELL_ALIGN_BROKEN",
      "detail": {
        "alignButtonEnabledWithCellFocused": {
          "present": true,
          "disabled": false,
          "label": "Align centre"
        },
        "afterAlignCentreOnCell": {
          "td_data_align": null,
          "td_computed_textAlign": "start",
          "cellTa_computed_textAlign": "start",
          "tableBlock_data_align": null,
          "firstBlock_data_align": null,
          "firstBlock_isTable": false
        },
        "afterAlignCentreOnOutsideBlock": {
          "td_data_align": null,
          "textBlock_data_align": "center",
          "allBlockAligns": [
            "center",
            null,
            "center"
          ]
        },
        "interpretation": "Align centre with a cell focused changes NOTHING on the cell, the table block, or computed style. Alignment is a no-op inside table cells."
      }
