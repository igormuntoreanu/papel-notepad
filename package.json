{
  "name": "app-builder-workspace",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8080",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:pages": "node scripts/build-static.mjs pages",
    "build:desktop": "node scripts/build-static.mjs desktop",
    "tauri:build": "node scripts/tauri-build.mjs",
    "package:v1": "node scripts/package-portable.mjs v1",
    "smoke:desktop": "node scripts/desktop-bridge-smoke.mjs",
    "preview": "vite preview",
    "preview:restart": "node scripts/preview.mjs restart",
    "preview:stop": "node scripts/preview.mjs stop",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'scripts/**/*.test.mjs' && node --experimental-strip-types --test src/lib/preview-path-prefix.test.ts src/lib/quire/quire.test.ts src/lib/quire/typefaces.test.ts src/lib/quire/lists.test.ts src/lib/quire/html-paste.test.ts src/lib/quire/urls.test.ts src/lib/quire/titles.test.ts src/lib/quire/tabs.test.ts src/lib/quire/versions.test.ts src/lib/desktop/fs-adapter.test.ts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
