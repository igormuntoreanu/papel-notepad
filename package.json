    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@tauri-apps/cli": "^2.12.4",
